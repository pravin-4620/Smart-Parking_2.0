# Server Configuration
PORT=5000
NODE_ENV=development
LOCAL_DEMO_AUTO_CONFIRM=false
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27018/smart_parking
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MQTT broker used by the backend ingestion client
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=smart-parking-backend
MQTT_USERNAME=smart-parking-backend
MQTT_PASSWORD=replace-with-generated-broker-password
# MQTT_CA_PATH=
# MQTT_CERT_PATH=
# MQTT_KEY_PATH=
MQTT_MAX_MESSAGE_BYTES=16384
IOT_ALLOW_AUTO_ENROLL=false
IOT_DEVICE_OFFLINE_AFTER_MS=120000

# AWS IoT Core Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_IOT_ENDPOINT=xxxxxx-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=smart-parking-backend

# Razorpay Sandbox Configuration

# Checkout and trusted hardware timing policy
REQUIRE_FINE_PAYMENT_BEFORE_EXIT=true
RFID_ENTRY_EARLY_MINUTES=15
SENSOR_FRESHNESS_MS=120000

# Google Maps API Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
