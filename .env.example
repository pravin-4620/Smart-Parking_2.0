# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/smart_parking
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MQTT broker used by the backend ingestion client
MQTT_BROKER_URL=mqtt://localhost:1883

# AWS IoT Core Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_IOT_ENDPOINT=xxxxxx-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=smart-parking-backend

# Razorpay Sandbox Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Maps API Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
